diff --git a/src/sycoca/ksycoca.cpp b/src/sycoca/ksycoca.cpp
index 981342e6..5940f65f 100644
--- a/src/sycoca/ksycoca.cpp
+++ b/src/sycoca/ksycoca.cpp
@@ -218,6 +218,13 @@ KSycoca::KSycoca()
         connect(d->m_fileWatcher.get(), &KDirWatch::dirty, this, [this]() {
             d->slotDatabaseChanged();
         });
+        // NIXPKGS: sycoca may be deleted externally during NixOS activation.
+        // Close the database so we stop using the old mmap, but don't emit
+        // databaseChanged or try to rebuild — the KDirWatch::created connection
+        // above will handle it when kbuildsycoca6 recreates the file later.
+        connect(d->m_fileWatcher.get(), &KDirWatch::deleted, this, [this]() {
+            d->closeDatabase();
+        });
     }
 }
